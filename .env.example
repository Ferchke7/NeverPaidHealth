# ==========================================
# NeverPaidHealth - Environment Configuration Template
# ==========================================

# Database
POSTGRES_USER=neverpaid
POSTGRES_PASSWORD=neverpaid_dev_password
POSTGRES_DB=postgres
DATABASE_URL=postgres://neverpaid:neverpaid_dev_password@localhost:5432/neverpaid_db?sslmode=disable

# NATS Event Bus
NATS_URL=nats://localhost:4222

# Ports & Services
GATEWAY_PORT=8080
IDENTITY_PORT=8081
EXERCISE_PORT=8082
TRAINING_PORT=8083
PROGRESS_PORT=8084
BODY_PORT=8085
COACH_PORT=8086
FRONTEND_PORT=3000

# Auth & Security
JWT_SECRET=super_secret_jwt_key_change_in_production
AUTH_DEV_MODE=true

# AI Coach (Optional - defaults to offline sports science rule engine)
GEMINI_API_KEY=
