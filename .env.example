# ==========================================
# NeverPaidHealth - Environment Configuration Template
# ==========================================

# Database
POSTGRES_USER=neverpaid
POSTGRES_PASSWORD=neverpaid_dev_password
POSTGRES_DB=postgres
DATABASE_URL=postgres://neverpaid:neverpaid_dev_password@localhost:5432/neverpaid_db?sslmode=disable

# NATS Event Bus
NATS_URL=nats://localhost:4222

# Ports & Services
GATEWAY_PORT=8080
IDENTITY_PORT=8081
EXERCISE_PORT=8082
TRAINING_PORT=8083
PROGRESS_PORT=8084
BODY_PORT=8085
COACH_PORT=8086
FRONTEND_PORT=3000

# Auth & Security (Google OAuth)
JWT_SECRET=super_secret_jwt_key_change_in_production
AUTH_DEV_MODE=true

# Google OAuth Credentials (Get from Google Cloud Console > APIs & Services > Credentials)
# Authorized JavaScript origins: https://duda.uz, http://localhost:3000, http://localhost:3002
# Authorized redirect URIs: https://duda.uz, https://duda.uz/api/v1/auth/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Domain URL
SITE_URL=https://duda.uz

# AI Coach (Optional - defaults to offline sports science rule engine)
GEMINI_API_KEY=
